<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 <application android:label="Pulse Media Player" android:theme="@style/AppTheme" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:usesCleartextTraffic="false" android:icon="@android:drawable/ic_media_play">
  <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
  <activity android:name=".LibraryActivity" android:exported="false"/>
  <activity android:name=".VideoActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden"/><activity android:name=".YouTubeActivity" android:exported="false"/>
  <service android:name=".WebPlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
  <service android:name=".PlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
 </application>
</manifest>
